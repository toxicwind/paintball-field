      "id": "CI-001",
      "severity": "high",
      "component": "ghostnode_p1",
      "issue": "18650 battery in objective node \u2014 soldering near lithium cell = fire/explosion hazard",
      "fix": "Replace with 3x AA battery holder or USB power bank"
    },
    {
      "id": "CI-002",
      "severity": "high",
      "component": "ghostband_p1",
      "issue": "Haptic motor \u2014 players in fast paintball won't feel vibration through gloves/mask adrenaline",
      "fix": "Remove haptic. Use bright LED + piezo buzzer (audible) or just LED patterns"
    },
    {
      "id": "CI-003",
      "severity": "medium",
      "component": "ghostband_p1",
      "issue": "350mAh LiPo in band \u2014 soft pouch can puncture from paintball impact",
      "fix": "Use hard-case LiPo (602030 300mAh hard shell) or CR123A primary cell holder"
    },
    {
      "id": "CI-004",
      "severity": "medium",
      "component": "ref_interface",
      "issue": "Tablet-based ref control \u2014 refs don't want $1200 phones on paintball field",
      "fix": "Dedicated rugged ref board with physical buttons, e-ink or transflective LCD"
    },
