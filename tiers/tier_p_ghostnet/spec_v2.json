{
  "tier_id": "tier_p_ghostnet",
  "tier_name": "GhostNet Pilot Tier",
  "version": "2.0",
  "status": "active",
  "philosophy": "The band is ONLY for enable/object. No HUD. No map. No radar. The ref sees everything. Players coordinate through haptic+LED signals. LoRaWAN cuts through walls/bunkers/metal where WiFi dies.",
  "key_principles": [
    "LoRaWAN 915MHz ISM \u2014 penetrates metal, concrete, bunkers, helicopter frames",
    "No OLED screen \u2014 players don't look at wrists during paintball",
    "No haptic motor \u2014 adrenaline + gloves = can't feel vibration. Use piezo buzzer instead.",
    "No 18650 batteries \u2014 fire/explosion hazard near solder. Use AA holders or CR123A.",
    "No $1200 phone on field \u2014 ref gets dedicated rugged e-ink board with physical buttons",
    "Sub-$250 kit for 8 players \u2014 pays for itself in 4-5 sessions at $5/player add-on"
  ],
