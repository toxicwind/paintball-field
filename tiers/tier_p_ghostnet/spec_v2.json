  "architecture": {
    "description": "LoRaWAN Class A, uplink-heavy. Bands send heartbeats every 5s, objective scans immediately.",
    "protocol_stack": "LoRaWAN 915MHz -> GhostHub -> MQTT -> Field Server -> RefBoard",
    "latency": "1-3s end-to-end. Fine for paintball pacing.",
    "penetration": "Cuts through: Blackhawk metal frame, castle concrete walls, warehouse corrugated steel, 200+ bunkers, trees, netting",
    "why_not_wifi": "WiFi 2.4GHz dies in metal structures, has 50-100m range, requires 6+ anchor APs. LoRa needs 1 gateway for entire 7.28-acre complex."
  },
